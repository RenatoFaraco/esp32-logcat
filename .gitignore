# --- PlatformIO / firmware ---
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ESP-IDF generates sdkconfig.<env> from sdkconfig.defaults; only the defaults are versioned
firmware/sdkconfig.*
!firmware/sdkconfig.defaults
firmware/managed_components/
firmware/dependencies.lock

# --- Python / host ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets (Wi-Fi credentials, keys) — keep them in local, untracked files ---
secrets.h
secrets.ini
*.local.ini
.env

# --- OS / editors ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
