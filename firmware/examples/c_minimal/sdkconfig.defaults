# What esp32-logcat needs from a project (the component's README.md explains each line).

CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# A partition table with the `logs` partition (LittleFS), next to this file.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The native USB port belongs to the logcat stream: no secondary ESP-IDF console there.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# `stats` reports the flash sectors erased since boot.
CONFIG_SPI_FLASH_ENABLE_COUNTERS=y

# `log level <tag> D` can open debug lines at run time only if they are compiled in.
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# Flash writes pause instead of stalling the CPU (check that your flash chip supports it).
CONFIG_SPI_FLASH_AUTO_SUSPEND=y

# LittleFS would write a modification time on every sync: wear for nothing.
# CONFIG_LITTLEFS_USE_MTIME is not set
