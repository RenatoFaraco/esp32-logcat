# Project-chosen ESP-IDF options. The full sdkconfig.<env> is generated and not versioned.

# Flash size of the target board (4 MB embedded, confirmed in docs/context/hardware.md)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table (logs + coredump). PlatformIO flashes it from board_build.partitions;
# this keeps ESP-IDF's own view (size checks, parttool) consistent with it.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Firmware rules (CLAUDE.md): no C++ exceptions, no RTTI
# CONFIG_COMPILER_CXX_EXCEPTIONS is not set
# CONFIG_COMPILER_CXX_RTTI is not set

# The native USB port (USB-Serial-JTAG) belongs to the logcat stream (UsbJtagSink, #12): no
# secondary ESP-IDF console there. The secondary console wrote the same FIFO directly (mixing
# bytes with the driver's) and blocked ~50 ms per line when no host was reading. The UART0
# console (CH340K) keeps bootloader and printf output plus a mirror of the log lines.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# `log level <tag> D` must be able to open a tag at run time, so D and V lines are compiled in.
# The default level stays INFO: until someone asks, a D line costs ESP-IDF's level lookup
# (a short mutex and a search in its tag cache), and never reaches the hook.
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y

# LittleFS for the `logs` partition (#24): no modification time, which would write an
# attribute on every sync (wear for nothing: the lines carry their own time).
# CONFIG_LITTLEFS_USE_MTIME is not set

# Writing the log to flash (#24) disables the cache for a sector erase or a page program; with
# nothing else, the 1 kHz critical task (#13) saw 20-25 ms stalls and up to 2251 missed periods
# per phase. Auto suspend pauses the erase/program when the CPU needs the cache: measured on this
# board (ESP32-C3, embedded XMC flash), max wake 0.2-1 ms and no missed period, the on-board
# LittleFS tests still pass. A chip or module with another flash must check its support again
# (ESP-IDF guide: "Optional Features for Flash", auto suspend). docs/context/hardware.md item 9.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
