{
    // The core tests are a plain CMake project (CMake Tools extension, presets native/asan/tsan).
    "cmake.sourceDirectory": "${workspaceFolder}/firmware/test/host",
    // IntelliSense for the firmware reads the compile database that `idf.py build` writes in
