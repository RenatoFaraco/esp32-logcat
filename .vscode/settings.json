{
    "cmake.sourceDirectory": "${workspaceFolder}/firmware",
    // The workspace root is the repository, not the PlatformIO project (firmware/), so the
    // PlatformIO extension does not generate c_cpp_properties.json here. IntelliSense reads the
    // compile database instead: `pio run -d firmware -e esp32c3 -t compiledb` (see README).
    "C_Cpp.default.compileCommands": "${workspaceFolder}/firmware/compile_commands.json"
}
