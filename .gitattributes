# Normalize text to LF in the repository and working tree, regardless of core.autocrlf.
# CI runs on Linux and log fixtures are parsed byte by byte on both sides (C++ and Python).
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts
*.bin binary
*.elf binary
*.png binary
*.jpg binary
*.gif binary
*.sr  binary

# Device captures: keep the exact bytes (the ESP-IDF console sends CRLF)
host/tests/fixtures/*.log binary
